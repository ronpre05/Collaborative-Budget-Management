{
	"templateName" : "Horizon RIA",

	"PC": 
	{
		"Name" : "Personnel",
		"Currency" : "EUR",
		"displayPM" : true,
		"PMPrivate" : true,
		"displayInt" : true,
		"Fields" : 
		{
			"Amount" : "Float",
			"startDate" : "String",
			"endDate" : "String",
			"Percentage" : "Float",
			"personMonth" : "Float"
		},
		"Calculations" :
		{
			"Person Months" : "(endDate - startDate) * Percentage",
			"Total" : "Amount"
		}
	},

	"EC" : 
	{
		"Name" : "Equipment",
		"Currency" : "EUR",
		"displayInt" : true,
		"Fields" : 
		{
			"What" : "String",
			"Why" : "String",
			"Amount" : "Float"
		},
		"Calculations" :
		{
			"Total" : "Amount"
		}
	},

	"OGC" : 
	{
		"Name" : "Other Goods and Services",
		"Currency" : "EUR",
		"displayInt" : true,
		"Fields" : 
		{
			"What" : "String",
			"Why" : "String",
			"Amount" : "Float"
		},
		"Calculations" :
		{
			"Total" : "Amount"
		}
	},

	"TC" : 
	{
		"Name" : "Travel Costs",
		"Currency" : "EUR",
		"displayInt" : true,
		"Fields" : 
		{
			"Days"  : "Int",
			"Accomodation" : "Float",
			"Sustinance" : "Float",
			"Entry" : 
			{
				"What" : "String",
				"Amount" : "Float"
			}
		},
		"Calculations" :
		{
			"baseTotal" : "Days*Accomodation + Days*Sustinance",
			"entryTotals" : "Entry.Amount",
			"Total" : "baseTotal + entryTotals"
		}
		
	},

	"SC" : 
	{
		"Name" : "Subcontracting",
		"Currency" : "EUR",
		"displayInt" : true,
		"Fields" : 
		{
			"What" : "String",
			"Why" : "String",
			"Amount" : "Float"
		},
		"Calculations" :
		{
			"Total" : "Amount"
		}
	},

	"IIC" : 
	{
		"Name" : "Internally Invoiced Services",
		"Currency" : "EUR",
		"displayInt" : true,
		"Fields" : 
		{
			"What" : "String",
			"Why" : "String",
			"Amount" : "Float"
		},
		"Calculations" :
		{
			"Total" : "Amount"
		}
	},

	"IC" : 
	{
		"Name" : "Indirect Costs",
		"Currency" : "EUR",
		"Calculations" : 
		{
			"Total" : "0.25 * (PC.Total + EC.Total + OGC.Total + TC.Total)"
		}
	}
}